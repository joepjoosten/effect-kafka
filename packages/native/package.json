{
  "name": "@effect-kafka/native",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "description": "Effect-native Kafka producers, consumers, SASL, compression and transactions over Node TCP/TLS",
  "repository": {
    "type": "git",
    "url": "https://github.com/joepjoosten/effect-kafka.git",
    "directory": "packages/native"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./SaslPrep": {
      "types": "./dist/SaslPrep.d.ts",
      "import": "./dist/SaslPrep.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-APACHE",
    "LICENSE-SASLPREP"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@effect-kafka/core": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^25.7.0",
    "effect": "4.0.0-rc.112",
    "typescript": "^6.0.3",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
